    "min_p": 0.0,
    "frequency_penalty": 0.0,
    "presence_penalty": 0.0,
    "repetition_penalty": 1.0,
    "n": 1,
    "seed": 20260812,
    "stream": false,
    "echo": false,
    "ignore_eos": true,
    "return_cached_tokens_details": true,
    "return_token_ids": true
  }
}
